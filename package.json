{
  "name": "dsh-conversation-stats",
  "version": "1.0.2",
  "description": "DSH Web GUI 会话统计插件：在顶部「对话」「轨迹」之后新增「会话统计」tab，列出每个对话的轮数、步数、token 用量（输入/输出/缓存）、模型调用、工具调用与耗时等数据，点击会话可查看逐条调用明细。数据直接解析 ~/.dsh/sessions 下的会话日志（zstd），无需常驻监听，历史对话同样可查。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "plugin",
    "session",
    "conversation",
    "stats",
    "tokens",
    "turns",
    "steps"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ]
}